# Backend
PORT=3000
FRONTEND_URL=http://localhost:3001

# Database (matches docker-compose.yml defaults — override both together)
DATABASE_URL=postgresql://game:game@localhost:5432/game

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-secret-key-here-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-here-min-32-chars

# OpenRouter (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-key-here

# Models. NOTE 2026-08-13: the code's own hardcoded fallbacks
# (google/gemini-2.0-flash-001, anthropic/claude-3.5-sonnet) both 404 on
# OpenRouter now — don't rely on them, always set these explicitly.
# google/gemini-2.5-flash-lite chosen 2026-08-13: cheapest real cost and
# fastest of everything tested (beats gpt-4o-mini and deepseek-v4-flash-0731
# on both price and speed — deepseek's reasoning tokens make it 3.7x more
# expensive in practice despite a cheaper sticker price). See
# docs/production/MODEL_RECOMMENDATIONS.md for the comparison.
LOGIC_MODEL=google/gemini-2.5-flash-lite
CREATIVE_MODEL=google/gemini-2.5-flash-lite
CREATIVE_MODEL_ALT=google/gemini-2.5-flash-lite
IMAGE_MODEL=google/gemini-2.5-flash-image

# Per-call deadline for LOGIC_MODEL/CREATIVE_MODEL/CREATIVE_MODEL_ALT calls
# (ms). Stopgap for audit finding H4 — bounds a hung request, doesn't fix
# why it's slow. Default 45000 if unset.
LLM_TIMEOUT_MS=45000
