{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist/backend",
    "rootDir": "src"
  },
  "include": ["src/backend/**/*.ts", "src/harness/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
