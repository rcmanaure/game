# Required — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides — T15's cost-model pass hasn't picked final models yet,
# these defaults are cheap-tier placeholders for harness eyeballing only.
LOGIC_MODEL=google/gemini-2.0-flash-001
CREATIVE_MODEL=anthropic/claude-3.5-sonnet
IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Testing config (free-tier, zero-cost) ---
# Verified 2026-08-05 by actually calling withStructuredOutput() against each
# — declared "tools" support in OpenRouter's model list does NOT guarantee it
# works: nvidia/nemotron-3-ultra-550b-a55b:free never invokes the tool
# (structured output silently falls back to the safe-default GameEvent), and
# with method:"jsonMode" it ignores the schema and invents its own fields.
# It IS reliable for plain narration text (CREATIVE_MODEL role only).
#
# LOGIC_MODEL history: cohere/north-mini-code:free worked once, then proved
# flaky on repeat testing (1/3 successful withStructuredOutput calls — see
# docs/research/2026-08-05-openrouter-free-model-candidates-research.md).
# nvidia/nemotron-3-super-120b-a12b:free tested clean 6/6 across two
# sessions (correctly discriminates eventType per action too) — current pick.
# Uncomment to use both during testing instead of the paid defaults above.
# LOGIC_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# CREATIVE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# T2: alt-model retry target for content-refusal fallback (narrate node) —
# deliberately a different provider than CREATIVE_MODEL, so a refusal
# rooted in one provider's content policy has a real chance of not
# repeating on retry. Defaults to the same model already vetted as
# LOGIC_MODEL above (also decent at narration, per 2026-08-05 testing).
# CREATIVE_MODEL_ALT=nvidia/nemotron-3-super-120b-a12b:free

# Skip the paid OpenRouter image call, return a free picsum.photos
# placeholder instead — saves image-gen credits while testing the
# LOGIC/CREATIVE pipeline. Set to "false" (or unset) for real art.
DISABLE_IMAGE_GEN=true
